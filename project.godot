; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Gamble With Friends - Casino Crawler"
config/description="1-6 player WebRTC P2P casino crawler. Phase 1: Input Map & Mobile-Friendly UI."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
FloorStreamer="*res://scripts/autoload/floor_streamer.gd"
Economy="*res://scripts/autoload/economy.gd"
NetSession="*res://scripts/autoload/net_session.gd"
TableRng="*res://scripts/autoload/table_rng.gd"
BetLedger="*res://scripts/autoload/bet_ledger.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
occlusion_culling/use_occlusion_culling=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=0
lights_and_shadows/directional_shadow/size=512
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=0
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
